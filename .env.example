# ---------------------------------------------------------------------------
# Settings for the Ayurveda clinic software.
# start.bat copies this file to ".env" the first time. Edit ".env", not this file.
# These are SAFE DEMO VALUES for your own PC only. Never use them on a real server.
# After changing .env, run stop.bat and then start.bat.
# ---------------------------------------------------------------------------

# development = your PC.  production = a real server (later).
APP_ENV=development
DJANGO_DEBUG=true
# A long random secret. Must be changed before real use.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-before-using-real-data
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (PostgreSQL in Docker)
POSTGRES_DB=ayurveda
POSTGRES_USER=ayurveda
POSTGRES_PASSWORD=ayurveda_dev_password

# Login security
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=12
# Log out after this many minutes without using the screen
IDLE_TIMEOUT_MINUTES=15
OTP_VALID_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Development only: also show the login OTP on the screen (it is always in logs.bat too)
SHOW_DEV_OTP_ON_SCREEN=true

# Key that encrypts medical history notes in the database. Empty = a development key.
# Before real use: ask Claude Code to generate one, and NEVER lose or change it afterwards.
FIELD_ENCRYPTION_KEY=

# Largest upload (patient documents), in MB
MAX_UPLOAD_MB=10

# Demo data. Must be false once you enter real patients (it allows "reset-demo-data.bat").
DEMO_MODE=true

# --- Service providers (free now; paid later only when the owner asks) ---
# AI_PROVIDER=ollama           (Step 10)
# STT_PROVIDER=whisper_local   (Step 10)
# OCR_PROVIDER=tesseract       (later)
WHATSAPP_PROVIDER=click_to_chat
SMS_PROVIDER=console
PAYMENT_PROVIDER=static_upi
EMAIL_PROVIDER=mailpit
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=clinic@example.com
STORAGE_PROVIDER=local
