# Builds the React screens and puts them inside a Caddy web server image (production only).
# ASK FIRST before editing. Used by docker-compose.prod.yml. Your PC (start.bat) does not use it.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
# The Caddyfile is mounted by docker-compose.prod.yml (deploy/Caddyfile)
