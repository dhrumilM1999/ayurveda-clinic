# ---------------------------------------------------------------------------
# Settings for the LIVE SERVER. Do not edit this example file.
# On the server run:  bash deploy/make-env.sh     -> it creates ".env" from this file and fills in the secrets.
# Lines marked  CHANGE-ME  are filled by make-env.sh (or by you). After editing .env run:  bash deploy/update.sh
# NEVER share .env, never put it in Git, never paste it in chat. Keep a copy of it in a password manager.
# ---------------------------------------------------------------------------

# --- Address ---------------------------------------------------------------
# The web address of the app, WITHOUT https://.  Must already point to the server (DNS A record).
APP_DOMAIN=app.example.com
# Optional: an email address that Let's Encrypt can warn if the certificate cannot renew.
ACME_EMAIL=

# --- Mode: do not change on a live server -----------------------------------
APP_ENV=production
DJANGO_DEBUG=false
DJANGO_HTTPS=true
# Secret code that protects logins. Long and random. Made by make-env.sh. Changing it logs everyone out.
DJANGO_SECRET_KEY=CHANGE-ME
# Which web addresses the backend answers to (same as APP_DOMAIN).
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# Address printed in the QR code on prescriptions ("is this genuine?" page).
PUBLIC_APP_URL=https://app.example.com
# The Caddy front door tells the backend the real visitor address; needed for login rate limits.
TRUST_X_FORWARDED_FOR=true
# Secret path of the Django admin page (made by make-env.sh): https://APP_DOMAIN/<ADMIN_URL>/
# Only letters, numbers and - . No slashes.
ADMIN_URL=CHANGE-ME

# --- Database (PostgreSQL inside Docker; not reachable from the internet) ---
POSTGRES_DB=ayurveda
POSTGRES_USER=ayurveda
# Made by make-env.sh. Only letters and numbers.
POSTGRES_PASSWORD=CHANGE-ME

# --- Encryption of medical notes --------------------------------------------
# Made by make-env.sh. IF YOU LOSE OR CHANGE THIS, OLD MEDICAL NOTES CANNOT BE READ AGAIN.
# Keep a copy outside the server (password manager). Backups do NOT contain it.
FIELD_ENCRYPTION_KEY=CHANGE-ME

# --- Login security -----------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=12
# Log out after this many minutes without using the screen
IDLE_TIMEOUT_MINUTES=15
OTP_VALID_MINUTES=5
OTP_MAX_ATTEMPTS=5
# MUST stay false on a live server (true would show login codes on the screen).
SHOW_DEV_OTP_ON_SCREEN=false
# Real patients will be entered: demo features OFF. Never set to true.
DEMO_MODE=false

# --- Files and limits ---------------------------------------------------------
STORAGE_PROVIDER=local
# Largest upload (patient documents), in MB
MAX_UPLOAD_MB=10

# --- Providers (all free) ------------------------------------------------------
# SMS is only written to the server log for now (no real SMS is sent). Staff use WhatsApp links.
SMS_PROVIDER=console
WHATSAPP_PROVIDER=click_to_chat
PAYMENT_PROVIDER=static_upi
# No email server on the live box. The app does not send email today.
EMAIL_PROVIDER=mailpit
# The AI helper (Translate button) needs Ollama, which does not run on the server: it says "AI is offline".
AI_PROVIDER=off

# --- Website enquiry form --------------------------------------------------------
# Websites that may send the online enquiry form, e.g. https://vednathayurved.com,https://www.vednathayurved.com
ENQUIRY_ALLOWED_ORIGINS=

# --- Speed (leave as it is) ------------------------------------------------------
# One worker + threads on purpose: login rate-limits are counted in memory.
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
