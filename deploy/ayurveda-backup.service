# Nightly backup job (systemd). SAFE TO EDIT: User and the folder path if yours are different.
# Install: see docs/GO_LIVE.md, step "Automatic backups".
[Unit]
Description=Ayurveda clinic nightly backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=clinic
WorkingDirectory=/home/clinic/ayurveda-clinic
ExecStart=/bin/bash /home/clinic/ayurveda-clinic/deploy/backup.sh
# Give up if it hangs for over 1 hour
TimeoutStartSec=3600
